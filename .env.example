# Copie para .env e preencha. Nunca versione o .env.
# Aqui ficam só segredos e infraestrutura. Provedor, modelo, limites, usuários e administradores
# são configurados na tela de Administração e ficam no banco (data/issue-doc-generator.db).

# ---------------------------------------------------------------------------
# Chaves de API (ficam só no servidor; o navegador nunca as recebe).
# Preencha as dos provedores que quiser usar; a Administração só deixa escolher os que têm chave.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Servidor compatível com a OpenAI (Ollama, LM Studio, OpenRouter, Groq…), se for usar.
# Ex.: http://localhost:11434/v1 (Ollama), https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Sessão e servidor
# ---------------------------------------------------------------------------
# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazio = segredo temporário: todos precisam entrar de novo quando o servidor reinicia.
SEGREDO_SESSAO=
SESSAO_HORAS=12
PORTA=3000
# true atrás de proxy reverso com HTTPS (nginx, Traefik, Caddy): cookie com Secure e IP real.
CONFIAR_PROXY=false

# Arquivo do banco SQLite. Padrão: data/issue-doc-generator.db na pasta onde o servidor roda
# (no Docker: /app/data/issue-doc-generator.db, num volume).
# ARQUIVO_BANCO=

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------
# Registrar o texto da descrição nos logs (LGPD: deixe false). O histórico de issues fica no banco
# e é apagado pela retenção configurada na Administração.
REGISTRAR_DESCRICAO=false
# Preço para o custo estimado no log, em US$ por milhão de tokens:
# entrada,saida,cacheLeitura,cacheEscrita. Vazio = tabela interna (só modelos Claude).
PRECO_POR_MTOK=
# Fallback de recusa do lado do servidor (só Claude API).
FALLBACK_RECUSA=true
MAX_TOKENS_SAIDA=64000

# ---------------------------------------------------------------------------
# Formato antigo (opcional). Só são lidos como ponto de partida, enquanto a Administração não
# salvar outro valor: PROVEDOR, MODELO, ESFORCO, LIMITE_POR_HORA, TEMPO_LIMITE_SEGUNDOS.
# USUARIOS_PERMITIDOS=email:senha,... é importado UMA vez se o banco estiver vazio (o 1º vira
# admin); depois pode ser apagado daqui.
# ---------------------------------------------------------------------------
