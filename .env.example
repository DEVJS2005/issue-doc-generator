# Copie para .env e preencha. Nunca versione o .env.
# Aqui ficam só segredos e infraestrutura. Provedor, modelo, limites, usuários e administradores
# são configurados na tela de Administração e ficam no banco (data/issue-doc-generator.db).

# ---------------------------------------------------------------------------
# Chaves de API (ficam só no servidor; o navegador nunca as recebe).
# Preencha as dos provedores que quiser usar; a Administração só deixa escolher os que têm chave.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Servidor compatível com a OpenAI (Ollama, LM Studio, OpenRouter, Groq…), se for usar.
# Ex.: http://localhost:11434/v1 (Ollama), https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Sessão e servidor
# ---------------------------------------------------------------------------
# Segredo que assina o estado do login único (SSO). A sessão de login fica no banco e não depende
# dele. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazio = segredo temporário: um login único em andamento falha se o servidor reiniciar no meio.
SEGREDO_SESSAO=
SESSAO_HORAS=12
# Chave para criptografar os backups do banco (AES-256-GCM). Opcional, mas recomendado: o backup
# tem os usuários e o histórico. Gere 32 bytes aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde uma cópia da chave FORA do servidor: sem ela, os backups criptografados não abrem.
BACKUP_CHAVE=
PORTA=3000
# Proxy reverso com HTTPS na frente (nginx, Traefik, Caddy): cookie com Secure e IP real de quem
# acessa (limite de login, auditoria). Valores:
#   false            sem proxy: usa o IP da conexão
#   true             1 proxy na frente (o mesmo que 1)
#   2, 3...          quantos proxies há na frente (ex.: CDN + nginx = 2)
#   127.0.0.1,10.0.0.0/8   lista de IP/CIDR dos proxies (o mais seguro, se os IPs forem fixos)
# Só ligue se a porta 3000 NÃO estiver aberta para a rede: quem falar direto com ela escreve o
# X-Forwarded-For que quiser.
CONFIAR_PROXY=false

# Arquivo do banco SQLite. Padrão: data/issue-doc-generator.db na pasta onde o servidor roda
# (no Docker: /app/data/issue-doc-generator.db, num volume).
# ARQUIVO_BANCO=

# ---------------------------------------------------------------------------
# Login único (SSO por OpenID Connect): Microsoft Entra ID, Google Workspace, Keycloak, Okta…
# Fica desligado enquanto OIDC_EMISSOR estiver vazio. O login por e-mail e senha continua valendo.
# No provedor, cadastre a URL de retorno exatamente igual a OIDC_URL_RETORNO.
# ---------------------------------------------------------------------------
# Ex.: https://login.microsoftonline.com/<tenant-id>/v2.0 ou https://accounts.google.com
OIDC_EMISSOR=
OIDC_CLIENTE_ID=
OIDC_CLIENTE_SEGREDO=
# Ex.: https://issues.empresa.com.br/api/sso/retorno (padrão: http://localhost:PORTA/api/sso/retorno)
OIDC_URL_RETORNO=
OIDC_ROTULO=Entrar com SSO
# Domínios cujos e-mails verificados viram usuário comum no 1º login, ex.: empresa.com.br
# Vazio = só entra quem um admin já cadastrou.
OIDC_DOMINIOS_AUTOCADASTRO=

# ---------------------------------------------------------------------------
# Jira (opcional): botão "Criar no Jira" na issue. Desligado com JIRA_URL ou JIRA_TOKEN vazio.
# Jira Cloud: e-mail da conta + token de API (id.atlassian.com/manage-profile/security/api-tokens).
# Jira Data Center: deixe JIRA_EMAIL vazio e use um token de acesso pessoal (PAT).
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
# Chaves dos projetos em que o time pode criar issues, separadas por vírgula (ex.: LOJ,APP).
# * libera todos os que o token alcança. Vazio: nenhum (o envio fica bloqueado).
JIRA_PROJETOS=

# ---------------------------------------------------------------------------
# Opcionais
# ---------------------------------------------------------------------------
# Registrar o texto da descrição nos logs (LGPD: deixe false). O histórico de issues fica no banco
# e é apagado pela retenção configurada na Administração.
REGISTRAR_DESCRICAO=false
# Preço para o custo estimado no log, em US$ por milhão de tokens:
# entrada,saida,cacheLeitura,cacheEscrita. Vazio = tabela interna (só modelos Claude).
PRECO_POR_MTOK=
# Fallback de recusa do lado do servidor (só Claude API).
FALLBACK_RECUSA=true
MAX_TOKENS_SAIDA=64000

# ---------------------------------------------------------------------------
# Formato antigo (opcional). Só são lidos como ponto de partida, enquanto a Administração não
# salvar outro valor: PROVEDOR, MODELO, ESFORCO, LIMITE_POR_HORA, TEMPO_LIMITE_SEGUNDOS.
# USUARIOS_PERMITIDOS=email:senha,... é importado UMA vez se o banco estiver vazio (o 1º vira
# admin); depois pode ser apagado daqui.
# ---------------------------------------------------------------------------
