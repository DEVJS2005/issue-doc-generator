# Copie para .env e preencha. Nunca versione o .env.
# As chaves ficam só no servidor; o navegador nunca as recebe.

# ---------------------------------------------------------------------------
# Provedor de IA: anthropic | openai | openai_compativel | gemini
# ---------------------------------------------------------------------------
PROVEDOR=anthropic

# Modelo. Vazio = padrão do provedor (só a Claude tem padrão: claude-opus-5-5).
# Para openai, openai_compativel e gemini, preencha com o nome exato do modelo.
MODELO=claude-opus-5-5

# Claude (PROVEDOR=anthropic)
ANTHROPIC_API_KEY=
# Esforço do modelo (só Claude): low | medium | high | xhigh | max
ESFORCO=medium
# Fallback de recusa do lado do servidor (só Claude API): se o filtro de segurança recusar,
# a própria API refaz o pedido num modelo de fallback recomendado.
FALLBACK_RECUSA=true

# ChatGPT (PROVEDOR=openai) e servidores compatíveis (PROVEDOR=openai_compativel)
OPENAI_API_KEY=
# Só para openai_compativel: URL base, ex. http://localhost:11434/v1 (Ollama),
# http://localhost:1234/v1 (LM Studio), https://openrouter.ai/api/v1, https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Gemini (PROVEDOR=gemini)
GEMINI_API_KEY=

# Limite de tokens de saída por geração e tempo máximo de uma geração.
MAX_TOKENS_SAIDA=64000
TEMPO_LIMITE_SEGUNDOS=180

# ---------------------------------------------------------------------------
# Uso e acesso
# ---------------------------------------------------------------------------
# Gerações (e refinamentos) por usuário por hora.
LIMITE_POR_HORA=30

# Login por e-mail e senha: lista separada por vírgula no formato email:senha.
# A senha pode conter ":", mas não vírgula. Sem nenhum usuário, ninguém consegue entrar.
# Exemplo fictício: ana@exemplo.dev:troque-esta-senha,bruno@exemplo.dev:outra-senha
USUARIOS_PERMITIDOS=

# Segredo que assina o cookie de sessão. Gere um valor longo e aleatório
# (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Vazio = segredo temporário: todos precisam entrar de novo quando o servidor reinicia.
# Trocar o valor derruba todas as sessões.
SEGREDO_SESSAO=
# Duração da sessão, em horas.
SESSAO_HORAS=12
# true quando o servidor fica atrás de um proxy reverso (nginx, Traefik, Caddy) que termina o HTTPS:
# assim o cookie sai com a flag Secure e o limite de login usa o IP real.
CONFIAR_PROXY=false

# Preço para a estimativa de custo no log, em US$ por milhão de tokens:
# entrada,saida,cacheLeitura,cacheEscrita. Vazio = tabela interna (só modelos Claude).
PRECO_POR_MTOK=

# Produtos que aparecem na lista da tela (a opção "Outro" é sempre incluída).
PRODUTOS=

# Porta HTTP do servidor.
PORTA=3000

# Registrar o texto da descrição nos logs (LGPD: deixe false, a menos que precise).
REGISTRAR_DESCRICAO=false
