{
  "name": "issue-doc-generator",
  "private": true,
  "version": "0.1.0",
  "description": "Gera issues completas e testáveis a partir de uma descrição curta, seguindo o ISTQB CTFL v4.0.1.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run typecheck --workspaces",
    "test:e2e": "npm run build && playwright test",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7"
  }
}
